# Terraform working directories
**/.terraform/*

# Terraform state
*.tfstate
*.tfstate.*

# Terraform plans
*.tfplan
*.plan
tfplan*

# Terraform Backend
backend.hcl

# Local variable definitions that may contain secrets
*.auto.tfvars
*.auto.tfvars.json
terraform.tfvars
terraform.tfvars.json

# CLI configuration and crash logs
.terraformrc
terraform.rc
crash.log
crash.*.log

# Python test and bytecode artifacts
.pytest_cache/
__pycache__/
*.py[cod]

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Keep dependency lock files under version control
!.terraform.lock.hcl
